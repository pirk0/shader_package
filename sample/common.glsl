// Образец пакета shader-package/1: пятно размытого фото с решёткой точек. На нём хосты гоняют
// свои стенды; правила — docs/format.md репо shader_package.

// ---- ручки: uniform, единый источник knobs.json -----------------------------------------------
uniform vec2  SPOT;     // =vec2(0.5, 0.5)  центр пятна, доля кадра от левого нижнего угла
uniform float RADIUS;   // =0.25  радиус пятна, доля высоты кадра
uniform float PULSE;    // =2.0  частота пульса радиуса, рад/с
uniform vec3  TINT;     // =vec3(0.0, 0.0, 0.0)  окраска пятна: поглощение по каналам RGB,
                        // (1 − цвет) · сила; ноль — без окраски
uniform float BLUR;     // =1.5  шаг размытия в текселях уменьшенного буфера; 0 — без размытия
uniform float COLS;     // =4.0  столбцов точек в пятне, округляется
uniform float ROWS;     // =3.0  строк точек в пятне, округляется
uniform vec2  SPIN;     // =vec2(1.0, 0.0)  поворот решётки точек: (cos, sin) угла
uniform vec3  DOT;      // =vec3(0.07, 0.03, 0.6)  точка: радиус и мягкость края в радиусах пятна,
                        // непрозрачность
uniform float LIGHT;    // =0.0  направление света на точках, рад

// ---- гейты: #define, смена перекомпилирует шейдер ---------------------------------------------
#define PULSE_MODE 0         // 0 пятно неподвижно | 1 радиус пульсирует во времени
#define EDGE(d)    (1.0 - smoothstep(0.0, 0.004, d))  // маска края пятна от расстояния d
#define MARGIN     0.02      // запас за краем пятна, доля высоты кадра: дальше пятно не считается
#define DOWNSCALE  2         // буфер размытия меньше кадра в DOWNSCALE раз: 1 | 2 | 4
#define MAX_DOTS   16        // потолок цикла точек
